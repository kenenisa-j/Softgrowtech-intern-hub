{
    "version": 2,
    "builds": [
        {
            "src": "apps/web-client/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "apps/api-server/api/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/apps/api-server/api/index.js"
        },
        {
            "src": "/((?!api/).*\\.[a-zA-Z0-9]+)",
            "dest": "/apps/web-client/$1"
        },
        {
            "src": "/((?!api/).*)",
            "dest": "/apps/web-client/index.html"
        }
    ]
}